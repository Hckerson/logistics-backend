DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public

# JWT — RS256. Generate a pair with `pnpm keys:generate`.
# Base64-encoded PEM. The private key signs and never leaves the backend;
# the frontend proxy gets JWT_PUBLIC_KEY only, so it can verify but not mint.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

PORT=5100
FRONTEND_URL=http://localhost:3100

TRACKING_TOKEN_SECRET=

STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
